
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider  = "postgresql"
  
  extensions = [pg_trgm, pgcrypto] 
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  password      String    
  name          String?
  role          Role           @default(USER)
  image         String?
  emailVerified DateTime?
  
  // Отношения (ИСПРАВЛЕНО: Каскадное удаление зависимых сущностей при удалении юзера)
  notifications Notification[]
  projects      Project[]      @relation("ProjectOwner")
  comments      Comment[]
  assignedTasks Task[]         @relation("TaskAssignee")
  
  // Таймстампы
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
  @@map("users")
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  color       String        @default("#3b82f6") 
  isPublic    Boolean       @default(false)
  status      ProjectStatus @default(ACTIVE)
  
  owner       User          @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId     String        @map("owner_id") // ⚡ ИСПРАВЛЕНО: Явный маппинг под стандарты Postgres
  tasks       Task[]
  
  createdAt   DateTime      @default(now()) @map("created_at") // Рекомендуется для таймстампов
  updatedAt   DateTime      @updatedAt @map("updated_at")
  
  @@map("projects")
  @@index([ownerId])
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      Status    @default(TODO)
  priority    Priority  @default(MEDIUM)
  order       Int       @default(0) 
  dueDate     DateTime? @map("due_date")
  
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String    @map("project_id") // ⚡ ИСПРАВЛЕНО
  assignee    User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeId  String?   @map("assignee_id") // ⚡ ИСПРАВЛЕНО
  comments    Comment[]
  
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  
  @@map("tasks")
  @@index([projectId, status, order])
  @@index([assigneeId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  isEdited  Boolean  @default(false) @map("is_edited")
  
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    String   @map("task_id") // ⚡ ИСПРАВЛЕНО
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String   @map("author_id") // ⚡ ИСПРАВЛЕНО
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  @@map("comments")
  @@index([taskId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notifications") // ИСПРАВЛЕНО: Добавлен маппинг таблицы в нижний регистр для консистентности PostgreSQL
}

enum Role {
  USER
  ADMIN
}

enum Status {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}